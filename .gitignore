# ---- 密钥与本地配置（绝不提交）----
native_host/winocr_config.json
.env
.env.*
*.local
*.key
*.pem
*.pfx
*.p12

# ---- 运行数据：OCR 记录、日志、名册、截图（含患者隐私）----
native_host/data/

# ---- 本机生成的 Native Messaging 安装产物（路径/扩展 ID 因机器而异）----
native_host/winocr_launcher.bat
native_host/com.winocr.host.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---- Node / 前端 ----
node_modules/

# ---- IDE / 系统垃圾 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时诊断产物（脚本默认写 native_host/data/，此条为双保险）----
*.tmp
_diag_*
_ocr_probe.txt
