{
  "manifest_version": 3,
  "name": "WinOCR-Html",
  "version": "0.7.6",
  "description": "选区翻译 + 截图 OCR + 日积累 MD 导出（工具栏弹窗版，兼容旧内核；翻译走 SiliconFlow）",
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "activeTab",
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.siliconflow.cn/*",
    "https://api.mymemory.translated.net/*",
    "https://*.siliconflow.cn/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "WinOCR-Html（点击开面板）",
    "default_icon": { "128": "icons/icon128.png" },
    "default_popup": "sidepanel.html"
  },
  "icons": { "128": "icons/icon128.png" },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/common.js", "js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "打开 WinOCR 面板"
    },
    "translate-selection": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "翻译当前选中"
    }
  }
}
