{
  "manifest_version": 3,
  "name": "WinOCR-Html",
  "version": "0.7.6",
  "minimum_chrome_version": "116",
  "description": "常驻侧栏翻译 + 截图 OCR + 日积累 MD 导出（翻译走 SiliconFlow；外部截图走原生宿主）",
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "activeTab",
    "tabs",
    "scripting",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.siliconflow.cn/*",
    "https://api.mymemory.translated.net/*",
    "https://*.siliconflow.cn/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "WinOCR-Html（点击开/关侧栏）",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "icons": { "128": "icons/icon128.png" },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/common.js", "js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "打开 WinOCR 侧栏"
    },
    "translate-selection": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "翻译当前选中"
    }
  }
}
